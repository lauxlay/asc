# Configuration de docker compose — copier en .env.
# Les mêmes variables sont attendues par Dokploy en staging et en production.

# Port exposé sur l'hôte (le container écoute toujours sur 3000).
PORT=3000

# Secret de signature des jetons — 32 caractères minimum, aucune valeur par
# défaut : un déploiement mal configuré doit échouer au démarrage.
# Générer avec : openssl rand -base64 48
JWT_SECRET=

# Durée de validité d'un jeton, en secondes (8 h).
JWT_EXPIRES_IN=28800

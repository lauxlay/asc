# Configuration de apps/api — copier en .env et adapter.
# Toutes les variables sont validées au démarrage : une valeur manquante ou
# invalide fait échouer le lancement avec un message explicite.

# Port d'écoute HTTP.
PORT=3000

# Racine du volume persistant (ADR-002). Jamais versionné.
DATA_DIR=./data

# Secret de signature des jetons — 32 caractères minimum, aucune valeur par
# défaut. À générer par déploiement : openssl rand -base64 48
JWT_SECRET=

# Durée de validité d'un jeton, en secondes (8 h par défaut).
JWT_EXPIRES_IN=28800
